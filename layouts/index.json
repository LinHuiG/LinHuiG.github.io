{{- $posts := slice -}}
{{- range partial "sort-posts.html" (where site.RegularPages "Section" "posts") -}}
  {{- $posts = $posts | append (dict "title" .Title "permalink" .RelPermalink "summary" (.Summary | plainify | htmlUnescape) "content" (.Plain | htmlUnescape)) -}}
{{- end -}}
{{- $posts | jsonify -}}
